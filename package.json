{
  "name": "tracker-hub",
  "version": "1.0.0",
  "private": true,
  "description": "MicroSaaS de rastreamento veicular",
  "scripts": {
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "prisma:generate": "pnpm --filter api exec prisma generate",
    "prisma:migrate": "pnpm --filter api exec prisma migrate dev",
    "dev:landing": "pnpm --filter landing-page dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm prisma:generate && pnpm --filter api start:dev",
    "dev:all": "pnpm --parallel --filter \"./apps/*\" dev",
    "build:all": "pnpm --filter \"./apps/*\" build",
    "test:all": "pnpm --filter \"./apps/*\" test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "msw",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
