DATABASE_URL="postgresql://tracker:tracker_pass@localhost:5433/tracker_hub"
# DIRECT_URL: usado pelo Prisma Migrate para conexão direta (sem pooler).
# Local (Docker): igual ao DATABASE_URL.
# Supabase: URL direta na porta 5432, sem ?pgbouncer=true.
# Ex: postgresql://postgres.<ref>:<senha>@aws-1-us-west-1.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://tracker:tracker_pass@localhost:5433/tracker_hub"
PORT=3333
JWT_SECRET=your_secret_key_here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Mail (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Tracker Hub <noreply@trackerhub.com.br>"

# Segredo compartilhado com a landing-page para o endpoint /mail/checkout-welcome
# Deve ser igual ao INTERNAL_API_SECRET configurado na landing-page
# Use um valor longo e aleatório (ex: openssl rand -hex 32)
INTERNAL_API_SECRET=changeme_use_a_strong_random_secret

# App
WEB_URL=http://localhost:5173
