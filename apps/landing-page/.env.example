# Stripe
STRIPE_SECRET_KEY=sk_test_...

# Price IDs — um por período (crie em Stripe Dashboard > Products > Prices)
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_QUARTERLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# Segredo compartilhado com a API para o endpoint /mail/checkout-welcome
# Use um valor longo e aleatório (ex: openssl rand -hex 32)
INTERNAL_API_SECRET=changeme_use_a_strong_random_secret

# URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_WEB_URL=http://localhost:5173
